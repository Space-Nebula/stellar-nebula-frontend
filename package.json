{
  "name": "stellar-nebula-frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "size-limit": "size-limit",
    "bundle:analyze": "node scripts/bundle-analysis.mjs",
    "bundle:check": "npm run build && npm run bundle:analyze",
    "bundle:update-baseline": "node scripts/bundle-analysis.mjs --update-baseline",
    "bundle:visualize": "open stats.html || xdg-open stats.html || echo 'Open stats.html manually'",
    "performance:test": "vitest run test/performance",
    "performance:lighthouse": "lhci autorun --config ./.lighthouserc.cjs",
    "performance:ci": "npm run build && node scripts/performance-ci.mjs",
    "preview": "vite preview",
    "docker:dev": "docker-compose up dev",
    "docker:build": "docker-compose build",
    "docker:prod": "docker-compose up prod",
    "prepare": "husky",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "release": "semantic-release",
    "release:dry-run": "semantic-release --dry-run",
    "test:a11y": "vitest run src/__tests__/a11y/",
    "sri:generate": "node scripts/generate-sri.mjs",
    "sri:update": "node scripts/generate-sri.mjs --update",
    "sri:check": "node scripts/generate-sri.mjs --check"
  },
  "dependencies": {
    "@albedo-link/intent": "^0.13.0",
    "@ledgerhq/hw-app-str": "^7.7.7",
    "@ledgerhq/hw-transport-webusb": "^6.35.0",
    "@react-three/drei": "^10.7.7",
    "@react-three/fiber": "^9.6.1",
    "@react-three/postprocessing": "^3.0.4",
    "@sentry/react": "^10.55.0",
    "@sentry/vite-plugin": "^5.3.0",
    "@stellar/stellar-sdk": "^15.1.0",
    "@walletconnect/modal": "^2.7.0",
    "@walletconnect/sign-client": "^2.24.0",
    "html2canvas": "^1.4.1",
    "postprocessing": "^6.39.1",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-hot-toast": "^2.6.0",
    "react-router-dom": "^6.30.1",
    "vite-plugin-pwa": "^1.3.0",
    "workbox-window": "^7.4.1"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx}": "prettier --write",
    "*.{json,css,md}": "prettier --write"
  },
  "devDependencies": {
    "@chromatic-com/storybook": "^5.2.1",
    "@eslint/js": "^9.39.1",
    "@faker-js/faker": "^9.9.0",
    "@lhci/cli": "^0.15.1",
    "@playwright/test": "^1.60.0",
    "@size-limit/file": "^13.0.3",
    "@size-limit/preset-app": "^13.0.3",
    "@storybook/addon-a11y": "^10.4.1",
    "@storybook/addon-docs": "^10.4.1",
    "@storybook/addon-essentials": "^8.6.14",
    "@storybook/addon-mcp": "^0.6.0",
    "@storybook/addon-vitest": "^10.4.1",
    "@storybook/react-vite": "^10.4.1",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/jest-axe": "^3.5.9",
    "@types/node": "^24.10.1",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@types/three": "^0.184.1",
    "@vitejs/plugin-react": "^5.1.1",
    "@vitest/browser-playwright": "^4.1.7",
    "@vitest/coverage-v8": "^4.1.7",
    "autoprefixer": "^10.5.0",
    "chromatic": "^17.2.0",
    "eslint": "^9.39.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "eslint-plugin-storybook": "^10.4.1",
    "globals": "^16.5.0",
    "happy-dom": "^20.9.0",
    "husky": "^9.1.7",
    "jest-axe": "^10.0.0",
    "jsdom": "^27.0.1",
    "lint-staged": "^16.4.0",
    "playwright": "^1.60.0",
    "postcss": "^8.5.15",
    "prettier": "^3.8.3",
    "rollup-plugin-visualizer": "^5.12.0",
    "size-limit": "^13.0.3",
    "storybook": "^10.4.1",
    "tailwindcss": "^3.4.19",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.48.0",
    "vite": "^7.3.1",
    "vitest": "^4.1.7"
  }
}
