# ============================================================
# Stellar Nebula Frontend — Environment Variables
# Copy this file to .env.local for development.
# All VITE_* variables are embedded into the client bundle at build time.
# ============================================================

# ── Application Runtime ──────────────────────────────────────
# [REQUIRED] Environment mode: development | staging | production
# Default: development
VITE_APP_ENV=development

# [OPTIONAL] Application display name
# Default: Stellar Nebula
VITE_APP_NAME=Stellar Nebula

# [OPTIONAL] Semver release version matching package.json
# Default: 0.0.0
VITE_APP_VERSION=0.0.0

# ── Stellar Network Configuration ───────────────────────────
# [REQUIRED] Active target network: testnet | futurenet | mainnet
# Default: testnet
VITE_STELLAR_NETWORK=testnet

# [REQUIRED] Soroban RPC HTTP endpoint URL
# Default: https://soroban-testnet.stellar.org
# Testnet: https://soroban-testnet.stellar.org
# Futurenet: https://rpc-futurenet.stellar.org
# Mainnet: https://soroban-rpc.stellar.org
VITE_STELLAR_RPC_URL=https://soroban-testnet.stellar.org

# [REQUIRED] Stellar Horizon REST API URL
# Default: https://horizon-testnet.stellar.org
# Testnet: https://horizon-testnet.stellar.org
# Futurenet: https://horizon-futurenet.stellar.org
# Mainnet: https://horizon.stellar.org
VITE_STELLAR_HORIZON_URL=https://horizon-testnet.stellar.org

# [REQUIRED] Network Passphrase used for cryptographic signing
# Default: Test SDF Network ; September 2015
# Testnet: Test SDF Network ; September 2015
# Futurenet: Test SDF Future Network ; October 2022
# Mainnet: Public Global Stellar Network ; September 2015
VITE_STELLAR_PASSPHRASE=Test SDF Network ; September 2015

# ── Smart Contract IDs ───────────────────────────────────────
# [REQUIRED for transactions] Deployed Soroban Nebula Contract C... address
# Example: CAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAABSC4
VITE_NEBULA_CONTRACT_ID=CAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAABSC4

# [REQUIRED for token ops] Deployed Soroban Token Contract C... address
# Example: CAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAABSC4
VITE_TOKEN_CONTRACT_ID=CAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAABSC4

# ── Backend API ──────────────────────────────────────────────
# [REQUIRED for off-chain sync] Base URL for the Nomad backend REST API
# Default: http://localhost:3000/api
VITE_API_BASE_URL=http://localhost:3000/api

# [OPTIONAL] Network timeout in milliseconds for API requests
# Default: 10000 (10 seconds)
VITE_API_TIMEOUT_MS=10000

# ── Monitoring & Observability ───────────────────────────────
# [OPTIONAL] Sentry client DSN (public ingestion key)
# Note: Public client identifier; do NOT add secret tokens here.
# Example: https://abc123xxx@o123456.ingest.sentry.io/1234567
VITE_SENTRY_DSN=

# [OPTIONAL] LogRocket App identifier (org/app-id)
# Example: my-org/nebula-nomad
VITE_LOGROCKET_APP_ID=

# [OPTIONAL] Custom telemetry ingestion endpoint URL
# Example: https://telemetry.stellarnebula.io/v1/events
VITE_ANALYTICS_ENDPOINT=

# [OPTIONAL] Global toggle for telemetry and error tracking
# Values: true | false. Default: true
VITE_ENABLE_MONITORING=true

# [OPTIONAL] Application log filter level
# Values: debug | info | warn | error. Default: info (warn in prod)
VITE_LOG_LEVEL=info

# ── Developer & Feature Flags ────────────────────────────────
# [OPTIONAL] Enable in-browser developer inspection tools
# Values: true | false. Default: true (false in prod)
VITE_ENABLE_DEV_TOOLS=true

# [OPTIONAL] Enable real-time WebGL FPS overlay monitor
# Values: true | false. Default: true (false in prod)
VITE_ENABLE_FPS_COUNTER=true
